msgctxt "Addon Summary"
msgid "Palm OS (Mu)"
msgstr "Palm OS (Mu)"

msgctxt "Addon Description"
msgid "Mu is a new Palm OS emulator targeting compatibility, speed and accuracy in that order.[CR][CR]Note: The BIOS files [I]palmos41-en-m515.rom[/I] and [I]palmos52-en-t3.rom[/I] are needed."
msgstr "Mu je nový emulátor Palm OS zaměřený v tomto pořadí na kompatibilitu, rychlost a přesnost.[CR][CR]Poznámka: Jsou vyžadovány soubory BIOSu [I]palmos41-en-m515.rom[/I] a [I]palmos52-en-t3.rom[/I]."

msgctxt "#30001"
msgid "CPU Speed"
msgstr "Rychlost CPU"

msgctxt "#30002"
msgid "Force Match System Clock"
msgstr "Vynutit shodu se systémovými hodinami"

msgctxt "#30003"
msgid "Ignore Invalid Behavior"
msgstr "Ignorovat neplatné chování"

msgctxt "#30004"
msgid "Use Left Joystick As Mouse"
msgstr "Používat levý joystick jako myš"

msgctxt "#30005"
msgid "Disable Graffiti Area"
msgstr "Zakázat oblast Graffiti"

msgctxt "#30006"
msgid "OS Version"
msgstr "Verze OS"
